# General
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints
.venv/
.env

# Data
# Ignore raw data (standard practice + potentially large)
data/raw/*
!data/raw/.gitkeep
# Allow processed data as requested
# data/processed/* 

# Models
# Allow models directory
!models/
models/*
# EXCLUDE the large file (>100MB)
models/best_tree_models_calibrated.joblib
# ALLOW the compressed version (<100MB)
!models/best_tree_models_calibrated.joblib.gz
# Allow other joblibs if they are <100MB
!models/*.joblib
!models/.gitkeep

# Final Models
!final_models/
final_models/*
!final_models/*.joblib

# Project specific
maintenance_scripts/
artifacts/
