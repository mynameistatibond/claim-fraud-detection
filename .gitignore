# General
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints
.venv/
.env

# Data
# Ignore raw data (standard practice + potentially large)
data/raw/*
!data/raw/.gitkeep
# Allow processed data as requested
# data/processed/* 

# Models
# 1. Ignore everything in models/
models/*
# 2. Allow models folder structure
!models/
# 3. Allow joblib files (Un-ignore)
!models/*.joblib
# 4. BUT IGNORE the large file (Re-ignore) - MUST come after the wildcard include!
models/best_tree_models_calibrated.joblib
# 5. Allow the compressed version
!models/best_tree_models_calibrated.joblib.gz
# 6. Allow gitkeep
!models/.gitkeep

# Final Models
!final_models/
final_models/*
!final_models/*.joblib

# Project specific
maintenance_scripts/
artifacts/
